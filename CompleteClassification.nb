         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#", "-", "d0"}], ")"}], "/", "d1"}], "&"}], "/@", 
         "divs"}], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"DeleteDuplicates", "@", 
       RowBox[{"Select", "[", 
        RowBox[{"cand", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"IntegerQ", "[", "#", "]"}], "&&", 
           RowBox[{"2", "<=", "#", "<=", "sBound"}]}], "&"}]}], "]"}]}]}]}], 
