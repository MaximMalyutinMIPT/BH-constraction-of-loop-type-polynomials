Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"solveS2", "[", 
    RowBox[{
    "a1_Integer", ",", "a3_Integer", ",", "a4_Integer", ",", 
     "sBound_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "b1", ",", "b0", ",", "d1", ",", "d0", ",", "R", ",", "divs", ",", 
       "cand"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"b1", "=", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "a1", "+", "a3", "-", 
        RowBox[{"a1", " ", "a3"}], "-", 
        RowBox[{"a3", " ", "a4"}], "+", 
        RowBox[{"a1", " ", "a3", " ", "a4"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"b0", "=", 
       RowBox[{"4", "-", "a1", "-", "a3", "-", "a4", "+", 
        RowBox[{"a3", " ", "a4"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"d1", "=", 
       RowBox[{"a1", "-", 
        RowBox[{"a1", " ", "a3"}], "-", 
        RowBox[{"a1", " ", "a4"}], "-", 
        RowBox[{"a3", " ", "a4"}], "+", 
        RowBox[{"a1", " ", "a3", " ", "a4"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"d0", "=", 
       RowBox[{"1", "-", "a1", "-", "a4", "+", 
        RowBox[{"a1", " ", "a4"}], "+", 
        RowBox[{"a3", " ", "a4"}], "-", 
        RowBox[{"a1", " ", "a3", " ", "a4"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"R", "=", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"b1", " ", "d0"}], "-", 
         RowBox[{"d1", " ", "b0"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"d1", "==", "0"}], "||", 
