                RowBox[{"D", "=", 
                 RowBox[{
                  RowBox[{"d1", " ", "#"}], "+", "d0"}]}]}], "}"}], ",", 
              RowBox[{
               RowBox[{"D", "!=", "0"}], "&&", 
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{"B", ",", "D"}], "]"}], "==", "0"}]}]}], "]"}], 
            "&"}]}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"divs", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Divisors", "[", "R", "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"Divisors", "[", "R", "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"cand", "=", 
